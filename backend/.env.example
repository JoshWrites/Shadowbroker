# ShadowBroker Backend — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required Keys ──────────────────────────────────────────────
# Without these, the corresponding data layers will be empty.

OPENSKY_CLIENT_ID=        # https://opensky-network.org/ — free account, OAuth2 client ID
OPENSKY_CLIENT_SECRET=    # OAuth2 client secret from your OpenSky dashboard
AIS_API_KEY=              # https://aisstream.io/ — free tier WebSocket key

# ── Optional ───────────────────────────────────────────────────

# Override allowed CORS origins (comma-separated). Defaults to localhost + LAN auto-detect.
# CORS_ORIGINS=http://192.168.1.50:3000,https://my-domain.com

# Admin key — protects sensitive endpoints (API key management, system update).
# If unset, these endpoints remain open (fine for local dev).
# Set this in production and enter the same key in Settings → Admin Key.
# ADMIN_KEY=your-secret-admin-key-here

# LTA Singapore traffic cameras — leave blank to skip this data source.
# LTA_ACCOUNT_KEY=

# Ukraine air raid alerts — register at devs.alerts.in.ua for a free bearer token.
# UKRAINE_ALERTS_TOKEN=

# Signal Archive listener — optional always-on collector for backfilling gaps.
# Set to the base URL of your listener service; leave unset to disable backfill.
# LISTENER_URL=http://10.100.102.107:7654

# Ukraine alerts listener — dedicated collector on LXC 110.
# Falls back to LISTENER_URL if unset.
# UKRAINE_LISTENER_URL=http://10.100.102.110:7654

# ── CCTV Tier 2 API Keys (optional — ingestors skip gracefully if unset) ──
# WINDY_API_KEY=           # https://api.windy.com/ — free tier, up to 10k webcams
# ITRAFFIC_SA_KEY=         # https://www.i-traffic.co.za/ — South Africa traffic cameras
# GA511_KEY=               # https://511ga.org/ — Georgia DOT cameras
# OHGO_KEY=                # https://publicapi.ohgo.com/ — Ohio DOT cameras
# QLD_TRAFFIC_KEY=         # https://api.qldtraffic.qld.gov.au/ — Queensland traffic
# ALBERTA_511_KEY=         # https://511.alberta.ca/ — Alberta traffic cameras
# MANITOBA_511_KEY=        # https://www.manitoba511.ca/ — Manitoba traffic cameras
